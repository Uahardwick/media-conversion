<Project>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Product>Media Tools Suite</Product>
    <Version>0.1.0</Version>
    <Company>UaHardwick</Company>
    <Authors>UaHardwick</Authors>
    <Copyright>Copyright © UaHardwick</Copyright>
  </PropertyGroup>

  <!-- Applies only to the Manager and the five WinExe tool projects, not
       Core or its tests, which stay plain library builds. -->
  <PropertyGroup Condition="'$(OutputType)' == 'WinExe'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
